
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Automerge all dependency updates, including major versions",
      "matchPackageNames": ["*"],
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
